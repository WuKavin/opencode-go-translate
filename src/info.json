{
    "identifier": "com.local.bob.translate.opencodogo",
    "version": "1.1.1",
    "category": "translate",
    "name": "OpenCode Go 翻译",
    "summary": "使用你自己的 OpenCode Go API Key（BYOK）调用大模型完成文本翻译。仅限账户持有人本机使用。",
    "icon": "001",
    "author": "kavin (WuKavin)",
    "homepage": "https://github.com/WuKavin/opencode-go-translate",
    "minBobVersion": "1.8.0",
    "options": [
        {
            "identifier": "apiKey",
            "type": "text",
            "title": "API Key",
            "desc": "OpenCode Go API Key（在 https://opencode.ai/auth 获取）。仅保存在 Bob 偏好设置中，不会写入文件或日志。",
            "textConfig": {
                "type": "secure",
                "placeholderText": "粘贴 OpenCode Go API Key"
            }
        },
        {
            "identifier": "model",
            "type": "menu",
            "title": "模型",
            "desc": "仅包含已核对 Go 协议与在线列表的 Chat Completions 模型。旧 Flash 用户请手动选择 V4.1 Flash。其他协议及免费模型暂不支持。",
            "defaultValue": "deepseek-v4.1-flash",
            "menuValues": [
                { "title": "DeepSeek V4.1 Flash", "value": "deepseek-v4.1-flash" },
                { "title": "DeepSeek V4 Pro", "value": "deepseek-v4-pro" },
                { "title": "GLM 5.3 Flash", "value": "glm-5.3-flash" },
                { "title": "GLM 5.3", "value": "glm-5.3" },
                { "title": "GLM 5.2", "value": "glm-5.2" },
                { "title": "Kimi K3", "value": "kimi-k3" },
                { "title": "Kimi K2.7 Code", "value": "kimi-k2.7-code" },
                { "title": "LongCat 2.0", "value": "longcat-2.0" },
                { "title": "MiMo V2.6 Flash", "value": "mimo-v2.6-flash" },
                { "title": "MiMo V2.6 Pro", "value": "mimo-v2.6-pro" },
                { "title": "MiMo V2.5", "value": "mimo-v2.5" },
                { "title": "MiMo V2.5 Pro", "value": "mimo-v2.5-pro" },
                { "title": "Step 5 Preview", "value": "step-5-preview" },
                { "title": "Hy4 Preview", "value": "hy4-preview" },
                { "title": "Hy3", "value": "hy3" }
            ]
        },
        {
            "identifier": "reasoningMode",
            "type": "menu",
            "title": "思考模式",
            "desc": "可对 DeepSeek V4.1 Flash / V4 Pro 实验性发送 reasoning_effort: none。V4.1 尚未实测，不保证参数生效或提速；拒绝时不自动重试，请手动改回模型默认行为。",
            "defaultValue": "model_default",
            "menuValues": [
                { "title": "使用模型默认行为", "value": "model_default" },
                { "title": "请求关闭思考（实验性，V4.1 Flash / V4 Pro）", "value": "disabled" }
            ]
        },
        {
            "identifier": "stream",
            "type": "menu",
            "title": "流式输出",
            "desc": "开启后译文将逐步显示。",
            "defaultValue": "enabled",
            "menuValues": [
                { "title": "开启", "value": "enabled" },
                { "title": "关闭", "value": "disabled" }
            ]
        },
        {
            "identifier": "requestTimeout",
            "type": "menu",
            "title": "请求超时",
            "desc": "单次 HTTP 请求的超时时间。",
            "defaultValue": "60",
            "menuValues": [
                { "title": "30 秒", "value": "30" },
                { "title": "60 秒", "value": "60" },
                { "title": "120 秒", "value": "120" }
            ]
        },
        {
            "identifier": "sessionId",
            "type": "text",
            "title": "Session ID（可选）",
            "desc": "用于 x-opencode-session 请求头（OpenCode Go 用于 prompt caching 优化）。留空将自动生成并保存在插件沙盒中。仅允许字母、数字和 . _ : -，长度 8–128。",
            "textConfig": {
                "type": "visible",
                "placeholderText": "留空自动生成，例如 bob-translate:xxxxxxxx"
            }
        }
    ]
}
